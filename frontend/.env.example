# Base URL for SkillGraph backend API requests.
# In development: typically /api (forwarded by Vite dev proxy to http://localhost:5000).
# In production: /api (proxied via Vercel rewrites) or https://<backend-host>/api
VITE_API_BASE_URL=/api

# Enable mock API data responses (development only; strictly forbidden in production).
# In production builds, mock mode is permanently disabled and Vite build fails if set to true.
VITE_USE_MOCKS=false
