# SkillGraph ML Service Environment Configuration

# Shared internal secret key for service-to-service authentication (required for /recommend and /model/info).
# Must match ML_INTERNAL_KEY in backend/.env.
# In production: Required, must be a strong secret of at least 16 characters (not a placeholder).
# In development: Set a matching secret token (e.g. generated via openssl rand -hex 16).
INTERNAL_KEY=your_development_shared_internal_key_min_16_chars

# Port and Host for Uvicorn ASGI server
PORT=8000
HOST=0.0.0.0

# Runtime environment mode (development, test, production)
# In production: requires strong INTERNAL_KEY and verifies model.joblib artifact exists at startup.
NODE_ENV=development

# Optional paths to shared seed and fixtures (defaults to ../shared/seed and ../shared/fixtures)
# SEED_DIR=../shared/seed
# FIXTURES_DIR=../shared/fixtures

# Optional paths to ML model artifact and metadata (defaults to models/model.joblib and models/model_info.json)
# MODEL_PATH=models/model.joblib
# MODEL_INFO_PATH=models/model_info.json
