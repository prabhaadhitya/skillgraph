# Environment runtime mode (development, test, production)
NODE_ENV=development

# HTTP server listening port
PORT=5000

# Allowed frontend client origin for CORS and credentials
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillgraph?retryWrites=true&w=majority

# Secret key used for signing HS256 JWT tokens (minimum 32 characters)
JWT_SECRET=your_32_character_minimum_random_secret_here

# Expiration lifespan for issued JSON Web Tokens
JWT_EXPIRES_IN=7d

# Force Secure flag on sg_token session cookie (automatically true in production)
COOKIE_SECURE=false

# 32-byte base64-encoded secret key for AES-256-GCM encryption of user LLM keys
LLM_KEY_ENCRYPTION_SECRET=your_base64_encoded_32_bytes_secret

# OpenRouter base API endpoint URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional server-level fallback OpenRouter API key for demo users
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder

# Default model identifier for OpenRouter calls when none chosen by user
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

# Daily quota limit for server fallback LLM key per user per day
SERVER_KEY_DAILY_LIMIT=30

# Timeout in milliseconds for OpenRouter HTTP requests
LLM_TIMEOUT_MS=20000

# Base URL for the Python FastAPI Machine Learning microservice
ML_SERVICE_URL=http://localhost:8000

# Shared secret key passed via X-Internal-Key header to authenticate with ML service
ML_INTERNAL_KEY=your_ml_internal_key_placeholder

# Timeout in milliseconds for internal calls to the ML microservice
ML_TIMEOUT_MS=3000

# Initial admin email address for the database seeder script
ADMIN_EMAIL=admin@skillgraph.dev

# Initial admin password for the database seeder script
ADMIN_PASSWORD=your_admin_secure_password_123

# Default password assigned to generated demo persona accounts
DEMO_PASSWORD=your_demo_secure_password_123

# Max requests per 15-minute window allowed on auth routes (/auth/login, /auth/register)
AUTH_RATE_LIMIT_MAX=10

# Max requests per 15-minute window allowed globally across API endpoints
GLOBAL_RATE_LIMIT_MAX=300
