# Server configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillgraph?retryWrites=true&w=majority

# Authentication & Sessions
JWT_SECRET=your_32_character_minimum_random_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# LLM & OpenRouter
LLM_KEY_ENCRYPTION_SECRET=your_base64_encoded_32_bytes_secret
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free
SERVER_KEY_DAILY_LIMIT=30
LLM_TIMEOUT_MS=20000

# Machine Learning Service
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_KEY=your_ml_internal_key_placeholder
ML_TIMEOUT_MS=3000

# Seed Credentials
ADMIN_EMAIL=admin@skillgraph.dev
ADMIN_PASSWORD=your_admin_secure_password_123
DEMO_PASSWORD=your_demo_secure_password_123
